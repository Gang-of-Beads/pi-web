// The server plugin API as a server plugin compiles it: with Node's types, without the DOM, so a
// declaration a server plugin reaches cannot depend on a browser type (alpha.8's StagedFile did).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/server-plugin-api.ts"]
}
