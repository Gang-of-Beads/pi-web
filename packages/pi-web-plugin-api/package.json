{
  "name": "@gang-of-beads/pi-web-plugin-api",
  "version": "0.1.0-alpha.5",
  "description": "Lightweight PI WEB browser and server plugin contracts, with TypeScript declarations and public runtime helpers.",
  "license": "MIT",
  "author": "Gang of Beads",
  "keywords": [
    "pi-web",
    "pi-web-plugin",
    "types"
  ],
  "homepage": "https://github.com/Gang-of-Beads/pi-web/blob/main/docs/plugin-api.md",
  "bugs": {
    "url": "https://github.com/Gang-of-Beads/pi-web/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    },
    "./server-plugin-api": {
      "types": "./dist/server-plugin-api.d.ts",
      "import": "./dist/server-plugin-api.js",
      "default": "./dist/server-plugin-api.js"
    }
  },
  "typesVersions": {
    "*": {
      "plugin-api": ["dist/plugin-api.d.ts"],
      "server-plugin-api": ["dist/server-plugin-api.d.ts"]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gang-of-Beads/pi-web.git",
    "directory": "packages/pi-web-plugin-api"
  },
  "dependencies": {
    "@types/ws": "^8.18.1"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p ../../tsconfig.plugin-api.json --outDir dist"
  }
}
