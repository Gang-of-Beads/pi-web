node_modules/
dist/
.env
.DS_Store
*.log
.playwright-cli/
.playwright-mcp/

# Keep one-off screenshots and other raster captures out of the repository root.
# Curated documentation images belong under docs/assets/ instead.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Local plugin development sandboxes. Symlink these into ~/.pi-web/plugins/<plugin-id>.
/dev-plugins/

# Local Docker image build hooks for development containers.
/docker/custom-image.d/*
!/docker/custom-image.d/.gitkeep

# Local runtime attachment uploads (created by the chat composer "save to folder" mode).
.pi-web/

# Dev docs site staging output (scripts/build-docs-dev.mjs).
/docs/.deploy/

# Playwright e2e artefacts
/test-results/
/playwright-report/

# Local agent runtime artifacts (background task logs, delegate sessions)
.pi/tasks/
.pi/delegate/
# Runtime state, not project material. `.pi/prompts` and `.pi/skills` are
# committed on purpose: they are things this project decided. Goals, the goal
# ledger and queued prompt frames are the record of one machine's session, and
# committing them meant every checkout inherited somebody else's half-finished
# work - five goals whose task lists all read as incomplete because the plugin
# had stopped recording against them.
# Derived cache the goal extension rebuilds from the goal files themselves.
.pi/.goals-pool-snapshot.json
.pi/goals/
.pi/queued-prompt-frames.json
